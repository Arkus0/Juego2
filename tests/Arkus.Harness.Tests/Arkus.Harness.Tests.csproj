<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>Arkus.Harness.Tests</AssemblyName>
    <RootNamespace>Arkus.Harness.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Proof-harness load closure only: HK01 independently scans every production assembly under src/.
         Keeping the MCP runtime dependency private here lets Reflection inspect that assembly without
         excluding it from the universe or making the test source depend on MCP APIs. -->
    <PackageReference Include="ModelContextProtocol.Core" PrivateAssets="all" />
    <PackageReference Include="xunit.core" />
    <PackageReference Include="xunit.assert" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Arkus.DesignWorld/Arkus.DesignWorld.csproj" />
    <ProjectReference Include="../../src/Arkus.EngineBridge/Arkus.EngineBridge.csproj" />
    <ProjectReference Include="../../src/Arkus.EngineBridge.UnityAuthoring/Arkus.EngineBridge.UnityAuthoring.csproj" />
    <ProjectReference Include="../../src/Arkus.Game.Authoring/Arkus.Game.Authoring.csproj" />
    <ProjectReference Include="../../src/Arkus.Game.Core/Arkus.Game.Core.csproj" />
    <ProjectReference Include="../../src/Arkus.Game.Validation/Arkus.Game.Validation.csproj" />
    <ProjectReference Include="../../src/Arkus.Game.World/Arkus.Game.World.csproj" />
    <ProjectReference Include="../../src/Arkus.Harness.Projection/Arkus.Harness.Projection.csproj" />
    <ProjectReference Include="../../src/Arkus.Harness.Protocol/Arkus.Harness.Protocol.csproj" />
    <ProjectReference Include="../../src/Arkus.Harness.Runtime/Arkus.Harness.Runtime.csproj" />
    <ProjectReference Include="../../tools/Arkus.H1.UnityHost/Arkus.H1.UnityHost.csproj" />
    <ProjectReference Include="../Arkus.Harness.H1LeaseCrashFixture/Arkus.Harness.H1LeaseCrashFixture.csproj" />
    <ProjectReference Include="../Arkus.Harness.MutationAttackFixture/Arkus.Harness.MutationAttackFixture.csproj" />
  </ItemGroup>
</Project>
