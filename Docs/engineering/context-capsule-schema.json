{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arkus.accepted-contract-capsule@1",
  "title": "Arkus Accepted-Contract Capsule v1",
  "type": "object",
  "required": [
    "schema",
    "authority",
    "capsule_id",
    "track",
    "content_mode",
    "accepted_identity",
    "identity_source",
    "authoritative_sources",
    "exported_guarantees",
    "exclusions_nonclaims",
    "reopen_conditions",
    "escalate_if",
    "mandatory_source_reads"
  ],
  "properties": {
    "schema": {"const": "arkus.accepted-contract-capsule@1"},
    "authority": {"const": "NON_AUTHORITATIVE_NAVIGATION_ONLY"},
    "capsule_id": {"type": "string", "minLength": 1},
    "track": {"enum": ["H0", "H1", "CITY", "PA", "CTX"]},
    "content_mode": {"enum": ["boundary_summary", "structured_disposition"]},
    "accepted_identity": {
      "type": "object",
      "required": ["reviewed_candidate_sha", "merge_sha", "review_id"],
      "additionalProperties": false,
      "properties": {
        "reviewed_candidate_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "merge_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "review_id": {"type": "string", "pattern": "^[0-9]+$"}
      }
    },
    "identity_source": {"$ref": "#/$defs/boundSource"},
    "authoritative_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/boundSource"}},
    "consumer_hints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "exported_guarantees": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/statement"}},
    "exclusions_nonclaims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/statement"}},
    "reopen_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "escalate_if": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "disposition_source": {"type": "object"},
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_key", "status"],
        "properties": {
          "source_key": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1}
        }
      }
    },
    "directional_semantics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "forward", "reverse", "must_remain_distinct"],
        "properties": {
          "id": {"type": "string"},
          "forward": {"type": "string"},
          "reverse": {"type": "string"},
          "must_remain_distinct": {"const": true}
        }
      }
    },
    "mandatory_source_reads": {"type": "array", "items": {"$ref": "#/$defs/mandatoryRead"}}
  },
  "$defs": {
    "boundSource": {
      "type": "object",
      "required": ["path", "git_blob_sha"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "git_blob_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "kind": {"type": "string"}
      }
    },
    "statement": {
      "type": "object",
      "required": ["id", "statement"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "source_pointer": {"type": "string"}
      }
    },
    "mandatoryRead": {
      "type": "object",
      "required": ["path", "git_blob_sha", "noncompressible", "reason"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "git_blob_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "noncompressible": {"const": true},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
