    "unitScale": "UnityMetres = FbxUnits * globalScale * (unitConversion ? UnitScaleFactor/100 : 1)",
    "rootCollapse": "a single top-level FBX node becomes the imported prefab root; several top-level nodes become children of a root named after the file",
    "materialSlots": "the multiset of imported slot materials equals the FBX material set of the node; Unity may order submeshes differently from FBX connection order",
    "boundsToleranceMetres": 0.0005
  },
