{
  "schemaVersion": 1,
  "workpack": "WP-HK-00",
  "description": "Single declarative source of truth for the canonical kernel classification and policy. Repository completeness is intentionally proof-owned and cannot be narrowed from this manifest.",
  "toolchain": {
    "globalJsonPath": "global.json",
    "sdk": {
      "version": "8.0.100",
      "rollForward": "latestPatch",
      "allowPrerelease": false
    },
    "allowedNoWarn": [
      "1701",
      "1702"
    ],
    "requireCentralPackageManagement": true
  },
  "projectClasses": {
    "portable-kernel": {
      "description": "Engine-agnostic portable library consumed by downstream hosts, including Unity later. Unity-compatible contract.",
      "production": true,
      "engineFree": true,
      "allowPackageReferences": false,
      "requireDeclaredEdgesExercised": true,
      "allowExternalCompiledSources": false,
      "requiredProperties": {
        "TargetFramework": "netstandard2.1",
        "LangVersion": "9.0",
        "Nullable": "enable",
        "RollForward": "LatestPatch",
        "ImplicitUsings": "disable",
        "TreatWarningsAsErrors": "true",
        "EnableNETAnalyzers": "true",
        "DisableTransitiveProjectReferences": "true",
        "Deterministic": "true",
        "DebugType": "portable",
        "EmbedAllSources": "true"
      }
    },
    "host": {
      "description": "Headless host/CLI. Pinned .NET 8, never consumed by Unity.",
      "production": true,
      "engineFree": true,
      "allowPackageReferences": false,
      "requireDeclaredEdgesExercised": true,
      "allowExternalCompiledSources": false,
      "requiredProperties": {
        "TargetFramework": "net8.0",
        "LangVersion": "9.0",
        "Nullable": "enable",
        "RollForward": "LatestPatch",
        "ImplicitUsings": "disable",
        "TreatWarningsAsErrors": "true",
        "EnableNETAnalyzers": "true",
        "DisableTransitiveProjectReferences": "true",
        "Deterministic": "true",
        "DebugType": "portable",
        "EmbedAllSources": "true"
      }
    },
    "tooling": {
      "description": "Build/proof tooling. Production source, but not part of the shipped kernel and never referenced by it.",
      "production": true,
      "engineFree": true,
      "allowPackageReferences": false,
      "requireDeclaredEdgesExercised": false,
      "allowExternalCompiledSources": false,
      "requiredProperties": {
        "TargetFramework": "net8.0",
        "LangVersion": "9.0",
        "Nullable": "enable",
        "RollForward": "LatestPatch",
        "ImplicitUsings": "disable",
        "TreatWarningsAsErrors": "true",
        "EnableNETAnalyzers": "true",
        "DisableTransitiveProjectReferences": "true",
        "Deterministic": "true",
        "DebugType": "portable",
        "EmbedAllSources": "true"
      }
    },
    "tests": {
      "description": "Test surface. Not production source; may reference pinned test packages.",
      "production": false,
      "engineFree": true,
      "allowPackageReferences": true,
      "requireDeclaredEdgesExercised": false,
      "allowExternalCompiledSources": true,
      "requiredProperties": {
        "TargetFramework": "net8.0",
        "LangVersion": "9.0",
        "Nullable": "enable",
        "RollForward": "LatestPatch",
        "ImplicitUsings": "disable",
        "TreatWarningsAsErrors": "true",
        "EnableNETAnalyzers": "true",
        "DisableTransitiveProjectReferences": "true",
        "Deterministic": "true",
        "DebugType": "portable",
        "EmbedAllSources": "true"
      }
    }
  },
  "projects": [
    {
      "name": "Arkus.Harness.Protocol",
      "path": "src/Arkus.Harness.Protocol/Arkus.Harness.Protocol.csproj",
      "class": "portable-kernel",
      "dependsOn": []
    },
    {
      "name": "Arkus.Game.Core",
      "path": "src/Arkus.Game.Core/Arkus.Game.Core.csproj",
