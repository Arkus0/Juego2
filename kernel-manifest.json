  "forbiddenAssemblyNamePatterns": [
    "UnityEngine",
    "UnityEngine.*",
    "UnityEditor",
    "UnityEditor.*",
    "Unity.*",
    "Assembly-CSharp",
    "Assembly-CSharp-*",
    "DaggerfallWorkshop*",
    "DaggerfallConnect*",
    "DaggerfallUnity*"
  ],
  "generatedSourceNamePatterns": [
    "*.AssemblyInfo.cs",
    "*.AssemblyAttributes.cs",
    "*.GlobalUsings.g.cs"
  ],
  "requiredFiles": [
    "global.json",
    "NuGet.config",
    "Directory.Build.props",
    "Directory.Packages.props",
    "Juego2.sln",
    "kernel-manifest.json",
