      "path": "tests/Arkus.Harness.Tests/Arkus.Harness.Tests.csproj",
      "class": "tests",
      "dependsOn": [
        "Arkus.Game.Authoring",
        "Arkus.Game.Core",
        "Arkus.Game.Validation",
        "Arkus.Game.World",
        "Arkus.Harness.Cli",
        "Arkus.Harness.Protocol",
        "Arkus.Harness.Runtime",
        "Arkus.Kernel.Proof"
