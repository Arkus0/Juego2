      ]
    },
    {
      "name": "Arkus.Game.Validation",
      "path": "src/Arkus.Game.Validation/Arkus.Game.Validation.csproj",
      "class": "portable-kernel",
      "dependsOn": [
        "Arkus.Game.Core",
        "Arkus.Game.World",
        "Arkus.Harness.Protocol"
      ]
    },
    {
      "name": "Arkus.Harness.Runtime",
